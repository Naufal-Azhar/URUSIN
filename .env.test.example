# Salin menjadi .env.test untuk integration test lokal.
# Database test dibuat otomatis oleh docker/postgres/init/03-test-db.sh.
DATABASE_URL=postgresql://urusin_app:change-me-app@127.0.0.1:5433/urusin_test?schema=public
TEST_DATABASE_URL=postgresql://urusin_app:change-me-app@127.0.0.1:5433/urusin_test?schema=public
MIGRATE_DATABASE_URL=postgresql://urusin_migrator:change-me-migrator@127.0.0.1:5433/urusin_test?schema=public
TEST_MIGRATE_DATABASE_URL=postgresql://urusin_migrator:change-me-migrator@127.0.0.1:5433/urusin_test?schema=public

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=test-secret-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
EMAIL_TRANSPORT=mailpit
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025
EMAIL_FROM=URUSIN Test <no-reply@urusin.test>
OFFICIAL_DOMAIN_ALLOWLIST=example.com
SEED_ADMIN_EMAIL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAGIC_LINK_PER_IP=20
RATE_LIMIT_MAGIC_LINK_PER_EMAIL=10
RATE_LIMIT_REPORT_PER_IP=10
RATE_LIMIT_AUTH_PER_IP=200
TRUST_PROXY=false

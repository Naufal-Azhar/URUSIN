# Salin menjadi .env dan isi nilai lokal. Jangan commit .env.
POSTGRES_PASSWORD=change-me-postgres
URUSIN_MIGRATOR_PASSWORD=change-me-migrator
URUSIN_APP_PASSWORD=change-me-app

DATABASE_URL=postgresql://urusin_app:change-me-app@127.0.0.1:5433/urusin?schema=public
MIGRATE_DATABASE_URL=postgresql://urusin_migrator:change-me-migrator@127.0.0.1:5433/urusin?schema=public

NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
EMAIL_TRANSPORT=mailpit
EMAIL_SERVER_HOST=127.0.0.1
EMAIL_SERVER_PORT=1025
EMAIL_FROM=URUSIN <no-reply@urusin.local>

# Hanya untuk development/test. Kosongkan di produksi.
SEED_ADMIN_EMAIL=

# Domain handoff yang diizinkan (dipisah koma). Untuk test gunakan example.com.
OFFICIAL_DOMAIN_ALLOWLIST=example.com

# Batas rate limit (opsional; default aman untuk produksi).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAGIC_LINK_PER_IP=5
RATE_LIMIT_MAGIC_LINK_PER_EMAIL=3
RATE_LIMIT_REPORT_PER_IP=3
# Set true hanya jika aplikasi berada di belakang reverse proxy tepercaya.
TRUST_PROXY=false
